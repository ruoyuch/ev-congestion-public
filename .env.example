# Copy this file to `.env` and edit the values for your machine.
# `.env` is gitignored; never commit it. Relative paths are resolved
# against the repository root. Variables already set in the shell win.

# --- Data locations -----------------------------------------------------
# Root of the raw PeMS archive. Must contain station_hour/<year>/*.txt and
# station_metadata/<year>/*.txt (layout produced by the `download_pems` stage).
# ~22 GB of text per year; only needed for the `station_year` stage.
# Default: data/raw/pems
# RAW_PEMS_DIR=/path/to/pems-data

# Repository data root and its sub-folders (defaults shown).
DATA_DIR=data
# INPUT_DIR=data/input
# INTERMEDIATE_DIR=data/intermediate
# Spatial files (zcta_ca.gpkg, ca_county/, ca_state/); shipped in data/gis.
GIS_DIR=data/gis

# Where the pipeline writes tables/, figures/ and logs/ (gitignored).
OUTPUT_DIR=output

# --- Software -----------------------------------------------------------
# Stata executable (MP, SE or BE). macOS example:
# STATA_BIN=/Applications/Stata/StataMP.app/Contents/MacOS/stata-mp
STATA_BIN=stata-mp

# --- Only needed to re-download source data ------------------------------
# Free key from https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
CHROMEDRIVER_PATH=/usr/local/bin/chromedriver
DOWNLOADS_DIR=~/Downloads

# --- Inference parameters ---------------------------------------------------
# Permutation draws and seed for the randomization test (paper: 1000, 20260704).
N_PERM=1000
SEED=20260704
